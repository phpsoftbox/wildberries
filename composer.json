{
    "name": "phpsoftbox/wildberries",
    "description": "Wildberries API client component for the PhpSoftBox framework",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anton K.",
            "email": "inspector-who@mail.ru"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^8.5",
        "phpsoftbox/collection": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "phpsoftbox/cli-app": "^1.0",
        "phpsoftbox/code-generator": "^1.0",
        "phpsoftbox/cs-fixer": "^1.2.2",
        "phpsoftbox/http-message": "^1.0",
        "phpunit/phpunit": "^13.3",
        "symfony/yaml": "^7.0"
    },
    "suggest": {
        "phpsoftbox/cli-app": "Required for the wildberries:openapi:generate-dto DTO generator command (maintainer tooling).",
        "phpsoftbox/code-generator": "Required for DTO generation from OpenAPI (maintainer tooling).",
        "symfony/yaml": "Required to read YAML OpenAPI specs during DTO generation."
    },
    "autoload": {
        "psr-4": {
            "PhpSoftBox\\Wildberries\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSoftBox\\Wildberries\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs:fix": "vendor/bin/psb-cs-fixer fix",
        "cs:check": "vendor/bin/psb-cs-fixer check --diff"
    },
    "prefer-stable": true
}
